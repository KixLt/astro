---
import BackToTop from './components/BackToTop.astro'

type ComponentType = 'BackToTop'

interface Props {
  components?: ComponentType[]
}
const { components } = Astro.props;
---

<div class="corner" id="Corner">
  {
    components?.map(v => (
        (() => {
          switch (v) {
            case 'BackToTop':
              return <BackToTop />
            default:
              break
          }
        })()
    ))
  }
</div>

<script>
const observerOptions: IntersectionObserverInit = {
  // Extend the root 100px upward: the menu appears only after the
  // scroll mark at the top of the page has been scrolled past.
  rootMargin: '-100px 0px 0px 0px',
}

const corner = document.getElementById('Corner')
const scrollMark = document.querySelector('.banner__content')
const headingsObserver = new IntersectionObserver(([entry]) => {
  const isAtTop = entry.isIntersecting
  corner?.classList.toggle('show', !isAtTop)
}, observerOptions)

// Observe the scroll mark rendered at the top of the page.
if (scrollMark)
  headingsObserver.observe(scrollMark)
</script>

<style lang="scss" is:global>
  #Corner {
    color: var(--tips-default);
    display: flex;
    justify-content: center;
    align-items: center;
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 9999;
    opacity: 0;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0.8rem;
    transform: scale(0.5);
    transition:
      all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      &.show {
        width: 3rem;
        height: 3rem;
        opacity: 1;
        transform: scale(1);
        padding: 0.25rem;
        border-width: 1px;
        pointer-events: auto;
      }
      &:hover{
        box-shadow: 0 4px 12px rgba(0, 0, 0, .15);
      }
  }
  #Corner svg {
    opacity: 1;
    transition: opacity 0.2s ease 0.1s;
  }
  #Corner:not(.show) svg {
    opacity: 0;
    transition: opacity 0.1s ease;
  }
</style>
