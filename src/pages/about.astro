---
import { getEntry, render } from 'astro:content'
import cfg from 'blog.config'
import PageShell from '@/components/layout/PageShell.astro'
import WideShell from '@/components/layout/WideShell.astro'
import ProfileCard from '@/components/page/left/ProfileCard.astro'

const { base } = cfg.WebsiteSettings

const aboutEntry = await getEntry('about', 'about')
if (!aboutEntry)
  throw new Error('about.md not found')
const { Content } = await render(aboutEntry)
---

<PageShell title={cfg.WebsiteSettings.text.about}>
  <WideShell>
    <Fragment slot="side">
      <ProfileCard
        name={cfg.UserInfo.name}
        introduction={cfg.UserInfo.introduction}
        avatar={cfg.UserInfo.avatar}
        links={cfg.UserInfo.link}
        base={base}
      />
    </Fragment>
    <Fragment slot="content">
      <div class="about prose">
        <Content />
      </div>
    </Fragment>
  </WideShell>
</PageShell>

<style lang="scss">
  .about {
    padding: 2rem;
    background-color: var(--background-default);
    border-radius: var(--radius-large);
    box-shadow: 0 2px 5px 0 rgba(0, 0, 0, 0.2), 0 2px 10px 0 rgba(0, 0, 0, 0.2);
  }
</style>
