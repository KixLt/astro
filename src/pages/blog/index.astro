---
import type { CollectionEntry } from 'astro:content'
import type { PostMeta } from '@/types/post.ts'
import { getCollection } from 'astro:content'
import cfg from 'blog.config'
import GridShell from '@/components/layout/GridShell.astro'
import PageShell from '@/components/layout/PageShell.astro'
import ProfileCard from '@/components/page/left/ProfileCard.astro'
import TagList from '@/components/page/left/TagList.vue'
import BlogList from '@/components/page/middle/BlogList.vue'
import Breadcrumb from '@/components/page/middle/Breadcrumb.astro'
import CategoryList from '@/components/page/right/CategoryList.vue'
import { getCoverImage } from '@/utils/cover.ts'

const { base } = cfg.WebsiteSettings

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .map(entry => toPostMeta(entry))

const tagCounts = new Map<string, number>()
const categoryCounts = new Map<string, number>()
for (const post of posts) {
  for (const tag of post.tags)
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)

  if (post.category)
    categoryCounts.set(post.category, (categoryCounts.get(post.category) ?? 0) + 1)
}

const tags = [...tagCounts.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => a.name.localeCompare(b.name))
const categories = [...categoryCounts.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => a.name.localeCompare(b.name))

const pageSize = cfg.pages.blog?.PageArticleCount ?? 10

function toPostMeta(entry: CollectionEntry<'blog'>): PostMeta {
  const chars = (entry.body ?? '').replace(/\s+/g, '').length
  return {
    slug: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.pubDate.toISOString(),
    updatedDate: entry.data.updatedDate?.toISOString(),
    tags: entry.data.tags,
    category: entry.data.category,
    cover: getCoverImage(entry),
    minutes: Math.max(1, Math.ceil(chars / 400)),
    words: chars,
  }
}
---

<PageShell title={cfg.WebsiteSettings.text.blog}>
  <GridShell>
    <Fragment slot="left">
      <ProfileCard
        name={cfg.UserInfo.name}
        introduction={cfg.UserInfo.introduction}
        avatar={cfg.UserInfo.avatar}
        links={cfg.UserInfo.link}
        base={base}
      />
      <TagList client:load tags={tags} />
    </Fragment>
    <Fragment slot="middle">
      <Breadcrumb base={base} items={[{ text: cfg.WebsiteSettings.text.blog }]} />
      <BlogList client:load posts={posts} pageSize={pageSize} base={base} />
    </Fragment>
    <Fragment slot="right">
      <CategoryList client:load categories={categories} isDetail={false} base={base} />
    </Fragment>
  </GridShell>
</PageShell>
